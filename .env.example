NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/shloka
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
FRONTEND_ORIGIN=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin User

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Approved access-request credentials (optional; see docs spec 2026-10-05).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=
CREDENTIAL_RETENTION=until_removed

# Email sending. Preferred: Brevo HTTPS API (works on hosts that block outbound
# SMTP, e.g. Render free). Key from Brevo -> SMTP & API -> API Keys.
BREVO_API_KEY=
# Sender address — must be a verified sender in Brevo (or your SMTP account).
SMTP_FROM=
# Where "new access request" notifications are sent.
SIGNUP_NOTIFY_EMAIL=
# Alternative to Brevo: raw SMTP (only on hosts that allow outbound SMTP).
# SMTP_HOST=   SMTP_PORT=   SMTP_USER=   SMTP_PASS=
